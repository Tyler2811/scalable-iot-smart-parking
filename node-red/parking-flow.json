    {
        "id": "f9dad128880cdc78",
        "type": "function",
        "z": "07d25d5ebcf748dd",
        "name": "Validate Parking Event",
        "func": "let data = msg.payload;\n\n// Convert Buffer to text if needed\nif (Buffer.isBuffer(data)) {\n    data = data.toString('utf8');\n}\n\n// Convert JSON text into a JavaScript object\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (error) {\n        node.warn('Invalid JSON message');\n        return null;\n    }\n}\n\n// Check required parking event fields\nif (\n    !data ||\n    !data.eventId ||\n    !data.carParkId ||\n    !data.spaceId ||\n    typeof data.occupied !== 'boolean' ||\n    !data.timestamp\n) {\n    node.warn('Invalid parking event');\n    return null;\n}\n\n// Save the converted object back into msg.payload\nmsg.payload = data;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
