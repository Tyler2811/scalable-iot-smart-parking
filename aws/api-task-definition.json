{
  "family": "smart-parking-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::814777258640:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::814777258640:role/smartParkingTaskRole",
  "containerDefinitions": [
    {
      "name": "smart-parking-api",
      "image": "814777258640.dkr.ecr.ap-southeast-2.amazonaws.com/smart-parking-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3002,
          "hostPort": 3002,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-southeast-2"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/smart-parking-api",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
