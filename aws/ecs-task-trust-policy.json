{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:ecs:ap-southeast-2:814777258640:*"
        },
        "StringEquals": {
          "aws:SourceAccount": "814777258640"
        }
      }
    }
  ]
}
