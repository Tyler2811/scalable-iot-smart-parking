{
  "family": "smart-parking-dashboard",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::814777258640:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "smart-parking-dashboard",
      "image": "814777258640.dkr.ecr.ap-southeast-2.amazonaws.com/smart-parking-dashboard:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/smart-parking-dashboard",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
